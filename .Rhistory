# Teste exato de Fisher entre `tipo_regiao` e `dengue_pattern`
table_tipo_regiao <- table(d1$tipo_regiao, d1$dengue_pattern)
fisher_test_tipo_regiao <- fisher.test(table_tipo_regiao)
# Teste exato de Fisher com simulação de Monte Carlo para `tipo_regiao` e `dengue_pattern`
fisher_test_tipo_regiao <- fisher.test(table_tipo_regiao, simulate.p.value = TRUE, B = 10000)
fisher_test_tipo_regiao
# Teste exato de Fisher com simulação de Monte Carlo para `bioma` e `dengue_pattern`
fisher_test_bioma <- fisher.test(table_bioma, simulate.p.value = TRUE, B = 10000)
fisher_test_bioma
