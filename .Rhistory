#chooseCRANmirror()
#install.packages('tinytex')
library(tinytex)
library(dplyr)
library(ggpubr)
library(ggplot2)
library(car)
library(MASS)
library(nnet)
library(tidyr)
# Carregar os dados
d3 <- left_join(read.csv2("Dengue/transicao10161722.csv"),
read.csv2("Determinantes/Tabelas/banco_determinantes.csv", fileEncoding = "latin1"),
by = "muni_code")
# Identificar colunas com valores NA
print(names(d3)[colSums(is.na(d3)) > 0])
# Transformar variáveis selecionadas em fatores
factor_vars <- c("transition","tipo_regiao", "bioma", "koppen")
d3[factor_vars] <- lapply(d3[factor_vars], factor)
# Função para criar gráficos de frequência relativa por região para Koppen
generate_koppen_plots_by_region <- function(data, file_name_prefix = "koppen_transition_region") {
library(ggplot2)
library(scales)
# Verificar se as colunas necessárias estão no dataframe
if (!all(c("koppen", "transition", "region") %in% colnames(data))) {
stop("As colunas 'koppen', 'transition' e 'region' devem estar presentes no dataframe.")
}
# Criar a tabela de contingência
table_values <- table(data$koppen, data$transition, data$region)
# Calcular as proporções (frequências relativas)
proportions <- apply(table_values, c(2, 3), function(x) x / rowSums(table_values))
# Transformar em dataframe
summary_df <- as.data.frame(as.table(proportions))
colnames(summary_df) <- c("koppen", "transition", "region", "Frequency")
# Traduzir e manter a ordem das categorias de transition em inglês
summary_df$Transition <- factor(summary_df$transition,
levels = c("Melhorou", "Se manteve", "Piorou"),
labels = c("Enhanced", "No change", "Worsened"))
# Definir cores para cada categoria de transition
transition_colors <- c(
"Enhanced" = "blue",
"No change" = "cornsilk4",
"Worsened" = "red"
)
# Gerar o gráfico com facet_wrap
plot <- ggplot(summary_df, aes(x = koppen, y = Frequency, fill = Transition)) +
geom_bar(stat = "identity", position = "dodge", width = 0.8) +
geom_text(aes(label = ifelse(Frequency > 0, round(Frequency * 100, 1), "")),
position = position_dodge(width = 0.8),
vjust = -0.5, size = 2.5) +
labs(title = "Koppen Climatic Types by Transition Across Regions",
x = "Koppen Climatic Types", y = "Relative Frequency", fill = "Transition") +
scale_y_continuous(labels = percent, breaks = seq(0, 1, by = 0.1)) +
scale_fill_manual(values = transition_colors) +
facet_wrap(~ region, scales = "free_x", ncol = 2) +
theme_minimal() +
theme(panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
strip.text = element_text(size = 10, face = "bold"),
axis.text.x = element_text(angle = 45, hjust = 1))
# Salvar o gráfico
file_name <- paste0(file_name_prefix, ".png")
ggsave(file_name, plot = plot, width = 14, height = 8, dpi = 300)
# Imprimir o gráfico
print(plot)
}
# Aplicar a função ao banco d3
generate_koppen_plots_by_region(d3, "figures/koppen_transition_region")
