) +
scale_fill_manual(
values = cores_padroes,
drop = FALSE,
na.value = "white",
name = "Transmission pattern"
) +
guides(
fill = guide_legend(
nrow = 1,
byrow = TRUE
)
) +
labs(title = "A - 2010–2016") +
coord_sf(expand = FALSE) +
tema_mapa
m1
m2 <- ggplot() +
geom_sf(
data = mapa_17_22,
aes(fill = pattern_en),
color = NA
) +
geom_sf(
data = ufs,
fill = NA,
color = "gray35",
linewidth = 0.20
) +
scale_fill_manual(
