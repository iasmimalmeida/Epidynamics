)
fig_dengue_transmission
# Packages
library(sf)
library(dplyr)
library(readr)
library(ggplot2)
library(patchwork)
library(stringr)
library(ggspatial)
# Helper function to find files in common project folders
find_file <- function(paths) {
file <- paths[file.exists(paths)][1]
if (is.na(file)) {
stop(
"File not found. I tried these paths:\n",
paste(paths, collapse = "\n")
)
}
file
}
# Input files
municipal_file <- find_file(c(
"data/muni_br.gpkg",
"../data/muni_br.gpkg",
"muni_br.gpkg",
"../muni_br.gpkg"
))
pattern_10_16_file <- find_file(c(
"table/2010-2016/dengue_pattern_10_16.csv",
"tables/2010-2016/dengue_pattern_10_16.csv",
"Tabelas_dengue/2010-2016/dengue_pattern_10_16.csv",
"../table/2010-2016/dengue_pattern_10_16.csv",
"../tables/2010-2016/dengue_pattern_10_16.csv",
"../Tabelas_dengue/2010-2016/dengue_pattern_10_16.csv"
))
pattern_17_22_file <- find_file(c(
"table/2017-2022/dengue_pattern_17_22.csv",
"tables/2017-2022/dengue_pattern_17_22.csv",
"Tabelas_dengue/2017-2022/dengue_pattern_17_22.csv",
"../table/2017-2022/dengue_pattern_17_22.csv",
"../tables/2017-2022/dengue_pattern_17_22.csv",
"../Tabelas_dengue/2017-2022/dengue_pattern_17_22.csv"
))
# Read dengue pattern data
pattern_10_16 <- read_csv2(pattern_10_16_file) |>
mutate(
muni_code = as.numeric(muni_code),
dengue_pattern = as.character(dengue_pattern)
)
pattern_17_22 <- read_csv2(pattern_17_22_file) |>
mutate(
muni_code = as.numeric(muni_code),
dengue_pattern = as.character(dengue_pattern)
)
# Read municipal geometry
municipalities <- st_read(
municipal_file,
quiet = TRUE
) |>
st_as_sf(sf_column_name = "geom") |>
mutate(
code_muni = as.numeric(code_muni),
code_state = as.numeric(code_state)
)
# Translate transmission pattern classes
translate_pattern <- function(x) {
x <- str_trim(x)
case_when(
x %in% c(
"Transmissão Persistente",
"Transmissao Persistente",
"transmissão persistente",
"transmissao persistente"
) ~ "Persistent transmission",
x %in% c(
"Epidêmico",
"Epidemico",
"epidêmico",
"epidemico"
) ~ "Epidemic",
x %in% c(
"Episódico/Epidêmico",
"Episodico/Epidemico",
"episódico/epidêmico",
"episodico/epidemico"
) ~ "Episodic/Epidemic",
x %in% c(
"Episódico",
"Episodico",
"episódico",
"episodico"
) ~ "Episodic",
x %in% c(
"Sem transmissão",
"Sem transmissao",
"sem transmissão",
"sem transmissao",
"Sem detecção de transmissão",
"Sem deteccao de transmissao",
"sem detecção de transmissão",
"sem deteccao de transmissao"
) ~ "No transmission",
TRUE ~ x
)
}
legend_order <- c(
"Persistent transmission",
"Epidemic",
"Episodic/Epidemic",
"Episodic",
"No transmission"
)
# Join classifications to municipal polygons
map_10_16 <- municipalities |>
left_join(
pattern_10_16,
by = c("code_muni" = "muni_code")
) |>
st_make_valid() |>
mutate(
pattern_en = translate_pattern(dengue_pattern),
pattern_en = factor(pattern_en, levels = legend_order)
)
map_17_22 <- municipalities |>
left_join(
pattern_17_22,
by = c("code_muni" = "muni_code")
) |>
st_make_valid() |>
mutate(
pattern_en = translate_pattern(dengue_pattern),
pattern_en = factor(pattern_en, levels = legend_order)
)
# Dissolve municipalities by transmission pattern
pattern_data_10_16 <- map_10_16 |>
filter(!is.na(pattern_en)) |>
group_by(pattern_en) |>
summarise(.groups = "drop")
pattern_data_17_22 <- map_17_22 |>
filter(!is.na(pattern_en)) |>
group_by(pattern_en) |>
summarise(.groups = "drop")
# Create state boundaries from the same municipal geometry
states_br <- municipalities |>
group_by(code_state) |>
summarise(.groups = "drop") |>
st_make_valid()
map_theme <- theme_void() +
theme(
plot.background = element_rect(
fill = "transparent",
color = NA
),
panel.background = element_rect(
fill = "transparent",
color = NA
),
legend.background = element_rect(
fill = "transparent",
color = NA
),
legend.box.background = element_rect(
fill = "transparent",
color = NA
),
plot.title = element_text(
size = 15,
face = "bold",
hjust = 0.5
),
legend.title = element_text(
size = 10,
face = "bold"
),
legend.text = element_text(
size = 8
),
legend.position = "bottom"
)
pattern_colors <- c(
"Persistent transmission" = "#F4C430",
"Epidemic" = "#F6E58D",
"Episodic/Epidemic" = "#2E86C1",
"Episodic" = "#76D7C4",
"No transmission" = "#6E6E6E"
)
plot_10_16 <- ggplot() +
geom_sf(
data = pattern_data_10_16,
aes(fill = pattern_en),
color = NA
) +
geom_sf(
data = states_br,
fill = NA,
color = "black",
linewidth = 0.35
) +
scale_fill_manual(
values = pattern_colors,
breaks = legend_order,
drop = FALSE,
name = "Transmission pattern"
) +
guides(
fill = guide_legend(ncol = 2, byrow = TRUE)
) +
annotation_north_arrow(
location = "tr",
which_north = "true",
style = north_arrow_fancy_orienteering
) +
labs(title = "A - 2010–2016") +
map_theme
plot_17_22 <- ggplot() +
geom_sf(
data = pattern_data_17_22,
aes(fill = pattern_en),
color = NA
) +
geom_sf(
data = states_br,
fill = NA,
color = "black",
linewidth = 0.35
) +
scale_fill_manual(
values = pattern_colors,
breaks = legend_order,
drop = FALSE,
name = "Transmission pattern"
) +
guides(
fill = guide_legend(ncol = 2, byrow = TRUE)
) +
annotation_north_arrow(
location = "tr",
which_north = "true",
style = north_arrow_fancy_orienteering
) +
labs(title = "B - 2017–2022") +
map_theme
Fig4 <- plot_10_16 + plot_17_22 +
plot_layout(ncol = 2)
Fig4
dir.create("figures", recursive = TRUE, showWarnings = FALSE)
ggsave(
"figures/Fig4.png",
Fig4,
width = 16,
height = 8,
units = "in",
dpi = 600,
bg = "transparent"
)
ggsave(
"figures/Fig4.tiff",
Fig4,
width = 16,
height = 8,
units = "in",
dpi = 600,
device = "tiff",
compression = "lzw",
bg = "transparent"
)
# Install if needed:
# install.packages(c("sf", "dplyr", "readr", "ggplot2", "patchwork", "stringr", "grid", "geobr"))
library(sf)
library(dplyr)
library(readr)
library(ggplot2)
library(patchwork)
library(stringr)
library(grid)
library(geobr)
find_file <- function(candidates) {
found <- candidates[file.exists(candidates)]
if (length(found) == 0) {
stop(
"File not found. I tried these paths:\n",
paste(candidates, collapse = "\n")
)
}
found[1]
}
file_10_16 <- find_file(c(
"table/2010-2016/dengue_pattern_10_16.csv",
"tables/2010-2016/dengue_pattern_10_16.csv",
"Tabelas_dengue/2010-2016/dengue_pattern_10_16.csv",
"../table/2010-2016/dengue_pattern_10_16.csv",
"../tables/2010-2016/dengue_pattern_10_16.csv",
"../Tabelas_dengue/2010-2016/dengue_pattern_10_16.csv"
))
file_17_22 <- find_file(c(
"table/2017-2022/dengue_pattern_17_22.csv",
"tables/2017-2022/dengue_pattern_17_22.csv",
"Tabelas_dengue/2017-2022/dengue_pattern_17_22.csv",
"../table/2017-2022/dengue_pattern_17_22.csv",
"../tables/2017-2022/dengue_pattern_17_22.csv",
"../Tabelas_dengue/2017-2022/dengue_pattern_17_22.csv"
))
file_10_16
file_17_22
municipalities <- read_municipality(code_muni = "all", year = 2020, simplified = TRUE)
states_br <- read_state(code_state = "all", year = 2020, simplified = TRUE)
municipalities <- municipalities %>%
mutate(code_muni = as.numeric(code_muni))
padrao_10_16 <- read_csv2(file_10_16) %>%
mutate(
muni_code = as.numeric(muni_code),
dengue_pattern = as.character(dengue_pattern)
)
padrao_17_22 <- read_csv2(file_17_22) %>%
mutate(
muni_code = as.numeric(muni_code),
dengue_pattern = as.character(dengue_pattern)
)
mapa_10_16 <- municipalities %>%
left_join(padrao_10_16, by = c("code_muni" = "muni_code"))
mapa_17_22 <- municipalities %>%
left_join(padrao_17_22, by = c("code_muni" = "muni_code"))
translate_pattern <- function(x) {
x <- str_trim(x)
case_when(
x %in% c(
"Transmissão Persistente",
"Transmissao Persistente",
"transmissão persistente",
"transmissao persistente"
) ~ "Persistent transmission",
x %in% c(
"Epidêmico",
"Epidemico",
"epidêmico",
"epidemico"
) ~ "Epidemic",
x %in% c(
"Episódico/Epidêmico",
"Episodico/Epidemico",
"episódico/epidêmico",
"episodico/epidemico"
) ~ "Episodic/Epidemic",
x %in% c(
"Episódico",
"Episodico",
"episódico",
"episodico"
) ~ "Episodic",
x %in% c(
"Sem transmissão",
"Sem transmissao",
"sem transmissão",
"sem transmissao",
"Sem detecção de transmissão",
"Sem deteccao de transmissao",
"sem detecção de transmissão",
"sem deteccao de transmissao"
) ~ "No transmission",
TRUE ~ NA_character_
)
}
legend_order <- c(
"Persistent transmission",
"Epidemic",
"Episodic/Epidemic",
"Episodic",
"No transmission"
)
mapa_10_16 <- mapa_10_16 %>%
mutate(pattern_en = factor(translate_pattern(dengue_pattern), levels = legend_order))
mapa_17_22 <- mapa_17_22 %>%
mutate(pattern_en = factor(translate_pattern(dengue_pattern), levels = legend_order))
pattern_colors <- c(
"Persistent transmission" = "#F4C430",
"Epidemic" = "#F6E58D",
"Episodic/Epidemic" = "#2E86C1",
"Episodic" = "#76D7C4",
"No transmission" = "#6E6E6E"
)
map_theme <- theme_void() +
theme(
plot.background = element_rect(fill = "transparent", color = NA),
panel.background = element_rect(fill = "transparent", color = NA),
legend.background = element_rect(fill = "transparent", color = NA),
legend.box.background = element_rect(fill = "transparent", color = NA),
plot.title = element_text(size = 15, face = "bold", hjust = 0.5),
legend.title = element_text(size = 10, face = "bold"),
legend.text = element_text(size = 8),
legend.position = "bottom"
)
make_north_arrow <- function(bbox) {
x <- bbox["xmax"] - 4.0
y <- bbox["ymax"] - 3.5
list(
annotate(
"segment",
x = x, xend = x,
y = y - 1.0, yend = y + 0.4,
arrow = arrow(length = unit(0.22, "cm"), type = "closed"),
linewidth = 0.5,
color = "black"
),
annotate(
"text",
x = x,
y = y + 0.8,
label = "N",
fontface = "bold",
size = 4
)
)
}
bbox_br <- st_bbox(states_br)
north_arrow <- make_north_arrow(bbox_br)
fill_scale <- scale_fill_manual(
values = pattern_colors,
breaks = legend_order,
drop = FALSE,
na.value = "white",
name = "Transmission pattern"
)
map_10_16_plot <- ggplot() +
geom_sf(
data = mapa_10_16,
aes(fill = pattern_en),
color = NA,
linewidth = 0
) +
geom_sf(
data = states_br,
fill = NA,
color = "black",
linewidth = 0.30
) +
north_arrow +
fill_scale +
labs(title = "A - 2010–2016") +
guides(fill = guide_legend(nrow = 1, byrow = TRUE)) +
coord_sf(expand = FALSE) +
map_theme
map_17_22_plot <- ggplot() +
geom_sf(
data = mapa_17_22,
aes(fill = pattern_en),
color = NA,
linewidth = 0
) +
geom_sf(
data = states_br,
fill = NA,
color = "black",
linewidth = 0.30
) +
north_arrow +
fill_scale +
labs(title = "B - 2017–2022") +
guides(fill = guide_legend(nrow = 1, byrow = TRUE)) +
coord_sf(expand = FALSE) +
map_theme
Fig4 <- map_10_16_plot + map_17_22_plot +
plot_layout(ncol = 2, guides = "collect") &
theme(
legend.position = "bottom",
legend.direction = "horizontal",
legend.title = element_text(size = 10, face = "bold"),
legend.text = element_text(size = 8)
)
Fig4
dir.create("figures", recursive = TRUE, showWarnings = FALSE)
ggsave(
"figures/Fig4.png",
plot = Fig4,
width = 16,
height = 8,
units = "in",
dpi = 300,
bg = "white"
)
ggsave(
"figures/Fig4.tiff",
plot = Fig4,
width = 16,
height = 8,
units = "in",
dpi = 600,
device = "tiff",
compression = "lzw",
bg = "white"
)
