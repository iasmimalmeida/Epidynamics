# Ajustar modelos adicionando as variáveis automaticamente
for (var in additional_vars) {
# Atualizar a fórmula adicionando a nova variável
updated_formula <- paste(base_formula, "+", var)
multinom_model <- multinom(as.formula(updated_formula), data = det_10_16)
# Exibir os resultados resumidos do modelo atualizado
cat("\nModelo ajustado com a variável adicional:", var, "\n")
print(summary(multinom_model))
# Atualizar a fórmula base com a variável adicionada
base_formula <- updated_formula
}
