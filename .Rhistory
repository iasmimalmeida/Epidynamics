traduz_padrao <- function(x) {
x <- str_trim(x)
case_when(
x %in% c(
"Transmissão Persistente",
"Transmissao Persistente",
"transmissão persistente",
"transmissao persistente"
) ~ "Persistent transmission",
x %in% c(
"Epidêmico",
"Epidemico",
"epidêmico",
"epidemico"
) ~ "Epidemic",
x %in% c(
"Episódico/Epidêmico",
"Episodico/Epidemico",
"episódico/epidêmico",
"episodico/epidemico"
) ~ "Episodic/Epidemic",
x %in% c(
"Episódico",
"Episodico",
"episódico",
"episodico"
) ~ "Episodic",
x %in% c(
"Sem transmissão",
