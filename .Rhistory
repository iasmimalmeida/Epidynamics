traduz_padrao <- function(x) {
x <- str_trim(x)
case_when(
x %in% c(
"Transmissão Persistente",
"Transmissao Persistente",
"transmissão persistente",
"transmissao persistente"
) ~ "Persistent transmission",
x %in% c(
"Epidêmico",
"Epidemico",
"epidêmico",
"epidemico"
) ~ "Epidemic",
x %in% c(
"Episódico/Epidêmico",
"Episodico/Epidemico",
"episódico/epidêmico",
"episodico/epidemico"
) ~ "Episodic/Epidemic",
x %in% c(
"Episódico",
"Episodico",
"episódico",
"episodico"
) ~ "Episodic",
x %in% c(
"Sem transmissão",
"Sem transmissao",
"sem transmissão",
"sem transmissao"
) ~ "No transmission",
TRUE ~ x
)
}
ordem_legenda <- c(
"Persistent transmission",
"Epidemic",
"Episodic/Epidemic",
"Episodic",
"No transmission"
)
mapa_10_16 <- mapa_10_16 %>%
mutate(
pattern_en = traduz_padrao(dengue_pattern),
pattern_en = factor(pattern_en, levels = ordem_legenda)
)
