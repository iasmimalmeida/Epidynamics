d_10_19 <- read_csv2("Dengue/dengue_pattern_10_19.csv")
d_20_22 <- read_csv2("Dengue/dengue_pattern_20_22.csv")
det <- read_csv2("Determinantes/banco_determinantes.csv")
# Usando dplyr::select() explicitamente
muni_d_10_19 <- dplyr::select(d_10_19, muni_code)
muni_det <- dplyr::select(det, muni_code)
# Encontre as diferenças
diferentes_d_10_19 <- setdiff(muni_d_10_19$muni_code, muni_det$muni_code)
diferentes_det <- setdiff(muni_det$muni_code, muni_d_10_19$muni_code)
# Mostre as diferenças
list(
muni_code_somente_no_d_10_19 = diferentes_d_10_19,
muni_code_somente_no_det = diferentes_det
)
# Primeiro, garantimos que ambas as tabelas tenham as colunas organizadas para a comparação
# Verifique se ambos os data frames têm o mesmo número de linhas
if (nrow(d_10_19) == nrow(det)) {
# Crie um vetor booleano para verificar se muni_code de d_10_19 é igual ao de det linha por linha
comparacao <- d_10_19$muni_code == det$muni_code
# Se todos forem TRUE, então todas as linhas são iguais, caso contrário, mostre as diferenças
if (all(comparacao)) {
print("Todos os valores de 'muni_code' são idênticos em ambas as tabelas.")
} else {
# Mostra as linhas onde há discrepância
diferentes <- which(!comparacao)
print("Diferenças encontradas nas seguintes linhas:")
print(diferentes)
# Exibe as linhas com diferenças de ambos os data frames
diferencas_d_10_19 <- d_10_19[diferentes, "muni_code"]
diferencas_det <- det[diferentes, "muni_code"]
# Exibe as diferenças lado a lado
resultado <- data.frame(
linha = diferentes,
muni_code_d_10_19 = diferencas_d_10_19,
muni_code_det = diferencas_det
)
print("Diferenças nas tabelas:")
print(resultado)
}
} else {
print("Os dois data frames têm um número diferente de linhas, portanto, não podem ser comparados diretamente.")
}
