cores_padroes <- c(
"Persistent transmission" = "#F4C430",
"Epidemic" = "#F6E58D",
"Episodic/Epidemic" = "#2E86C1",
"Episodic" = "#76D7C4",
"No transmission" = "#6E6E6E"
)
bbox_br <- st_bbox(muni)
x_north <- as.numeric(bbox_br["xmax"] - 3.6)
y_north <- as.numeric(bbox_br["ymax"] - 4.2)
north_arrow <- list(
annotate(
"segment",
x = x_north,
xend = x_north,
y = y_north - 1.0,
yend = y_north + 0.6,
arrow = arrow(length = unit(0.22, "cm"), type = "closed"),
linewidth = 0.55,
color = "black"
),
annotate(
"text",
x = x_north,
y = y_north + 1.0,
label = "N",
fontface = "bold",
size = 3.8,
color = "black"
)
)
tema_mapa <- theme_void() +
theme(
plot.title = element_text(size = 14, face = "bold", hjust = 0),
legend.position = "bottom",
legend.title = element_text(size = 11, face = "bold"),
legend.text = element_text(size = 9),
legend.key.width = unit(0.7, "cm"),
legend.key.height = unit(0.4, "cm"),
plot.margin = margin(4, 4, 4, 4)
)
m1 <- ggplot() +
geom_sf(
data = mapa_10_16,
aes(fill = pattern_en),
color = NA,
linewidth = 0
) +
geom_sf(
data = ufs,
fill = NA,
color = "gray35",
linewidth = 0.22
) +
north_arrow +
scale_fill_manual(
values = cores_padroes,
breaks = ordem_legenda,
drop = FALSE,
na.value = "white",
name = "Transmission pattern"
) +
guides(
fill = guide_legend(
nrow = 1,
byrow = TRUE,
override.aes = list(color = NA)
)
) +
labs(title = "A - 2010–2016") +
coord_sf(expand = FALSE) +
tema_mapa
