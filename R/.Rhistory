# Combinando as variáveis dummies ao dataset original
data_comb <- cbind(data, dados_dummies)
# Verificando as primeiras linhas para confirmar as transformações
head(data_comb)
View(data_comb)
modelo <- multinom(Transition ~ temp_umid_interaction + temp_precip_interaction +
pop_esgot_interaction + pop_residuo_interaction +
altitude_regiao_interaction + bioma_regiao_interaction +
log_pop22 + precip_classBaixa + precip_classMédia + precip_classAlta +
outros_dummies_gerados,
data = data_comb)
