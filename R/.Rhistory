# Obter os coeficientes do modelo
coeficientes <- summary(model_final)$coefficients
erro_padrao <- summary(model_final)$standard.errors
# Calcular OR, IC 95% e p-valores
OR <- exp(coeficientes)
IC_inf <- exp(coeficientes - 1.96 * erro_padrao)
IC_sup <- exp(coeficientes + 1.96 * erro_padrao)
p_valor <- 2 * (1 - pnorm(abs(coeficientes / erro_padrao)))
# Criar tabela com OR, IC 95% e p-valor
tabela_resultado <- cbind(OR, IC_inf, IC_sup, p_valor)
# Arredondar para 2 casas decimais
tabela_resultado <- round(tabela_resultado, 2)
# Exibir a tabela
tabela_resultado
View(tabela_resultado)
#Lendo
#banco_determinantes <- read_csv2("Dados/Determinantes/banco_determinantes.csv")
banco_determinantes <- read_csv2("banco_determinantes_patt.csv")
#2017-2022
#clima_org_model_17_22_season <- read_csv("Dados/Determinantes/clima/clima_org_model_17_22_season.csv")
clima_org_model_17_22_season <- read_csv("clima_org_model_17_22_season.csv")
clima_org_model_17_22_season <- clima_org_model_17_22_season[, -1]  # Exclui a primeira coluna
colnames(clima_org_model_17_22_season)[1] <- "muni_code"  # Renomeia a nova primeira coluna
# Juntando
det_17_22 <- full_join(banco_determinantes, clima_org_model_17_22_season , by = "muni_code")
det_17_22  <- det_17_22 [, !names(det_17_22) %in% c("pop10")]
## Removendo os bancos para a nálise ficar mais leve
remove(banco_determinantes)
remove(clima_org_model_17_22_season)
# Converter variáveis numéricas com vírgula decimal e categorizar as variáveis de texto
det_17_22 <- det_17_22 %>%
mutate(
across(where(~ all(grepl("^[0-9,.]+$", .))), ~ as.numeric(gsub(",", ".", .))),
across(where(is.character), as.factor))
# Visão geral dos dados
summary(det_17_22)
# Remover colunas pelo nome
det_17_22 <- det_17_22[, !names(det_17_22) %in% c("muni_code")]
det_17_22$region <- as.factor(det_17_22$region)
# removendo as linhas com Na
det_17_22 <- det_17_22%>%
filter(!if_any(where(is.numeric), is.na))
# Definir a categoria de referência para todas as variáveis categóricas
det_17_22$dengue_pattern <- relevel(det_17_22$dengue_pattern, ref = "Episódico/Epidêmico") # variável dependente
# Variáveis independentes
summary(det_17_22)
det_17_22$bioma <- relevel(det_17_22$bioma, ref = "mata atlantica")
det_17_22$tipo_regiao <- relevel(det_17_22$tipo_regiao , ref = "nao metropolitana")
det_17_22$koppen <- relevel(det_17_22$koppen, ref = "Aw")
summary(det_17_22)
# Modelo com tudo
multinom_model <- multinom(dengue_pattern ~ ., data = det_17_22)
summary(multinom_model)
View(det_17_22)
