# Pode-se considerar um ponto de corte, como por exemplo resíduos > 2 ou < -2 como influentes
cutoff <- 2.0
influential_points <- which(abs(deviance_residuals) > cutoff)
# Exibir as observações influentes
print(data[influential_points, ])
