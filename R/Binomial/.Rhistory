vif_values <- vif(binomial_model)
# Exibir os valores de VIF
cat("\nValores de VIF:\n")
print(vif_values)
# Identificar variáveis com VIF menor ou igual a 10
variaveis_mantidas <- names(vif_values)[vif_values <= 10]
# Atualizar os dados removendo variáveis com VIF > 10
det_17_22 <- det_17_22[, c(variaveis_mantidas)]  # Mantém a variável dependente + variáveis com VIF adequado
# Exibir as variáveis que foram mantidas
cat("\nVariáveis mantidas após remoção de VIF alto:\n")
print(names(det_17_22))
# Salvando banco
write.csv(vif_values, "vif_binomial_model_17_22.csv", row.names = FALSE)
View(det_17_22)
