library(nnet)
library(caret)
library(pscl)
library(DescTools)
library(car)
library(broom)
library(boot)
library(dplyr)
library(caret)
library(lmtest)
library(gt)
library(ResourceSelection)
library(pROC)
library(MASS)
library(performance)
library(knitr)
library(kableExtra)
setwd("~/GitHub/Epidynamics/R/Binomial/1722")
#Lendo
banco_determinantes <- read_csv2("banco_determinantes_bi.csv")
clima_org_model_17_22_season <- read_csv("clima_org_model_17_22_season.csv")
names(clima_org_model_17_22_season )
#Excluido as variáveis que não serão utilizadas
banco_determinantes <- banco_determinantes[,!(names(banco_determinantes) %in%
c("...1","altitude"))]
clima_org_model_17_22_season <- clima_org_model_17_22_season[,!(names(clima_org_model_17_22_season) %in%
c("...1",    "dengue_pattern","thr_umid_Spring","thr_temp_umid_Autumn" ))]
# Renomeia a nova primeira coluna
colnames(clima_org_model_17_22_season)[1] <- "muni_code"
# Juntando
det_17_22 <- full_join(banco_determinantes, clima_org_model_17_22_season , by = "muni_code")
det_17_22 <- det_17_22[, !names(det_17_22) %in% c("pop10")]
## Removendo os bancos para a nálise ficar mais leve
remove(banco_determinantes)
remove(clima_org_model_17_22_season)
# Converter variáveis numéricas com vírgula decimal e categorizar as variáveis de texto
det_17_22 <- det_17_22 %>%
mutate(
across(where(~ all(grepl("^[0-9,.]+$", .))), ~ as.numeric(gsub(",", ".", .))),
across(where(is.character), as.factor))
det_17_22$dengue_pattern_17_22 <- as.factor(det_17_22$dengue_pattern_17_22)
det_17_22$dengue_pattern_10_16 <- as.factor(det_17_22$dengue_pattern_10_16)
# Visão geral dos dados
summary(det_17_22)
# Filtrar apenas os muni_code onde há pelo menos um NA em outras colunas
muni_com_na <- det_17_22[rowSums(is.na(det_17_22)) > 0, "muni_code"]
# Exibir os muni_code afetados
print(unique(muni_com_na))
# Verificação de valores ausentes
cat("Valores ausentes por variável:\n")
print(colSums(is.na(det_17_22)))
# Remover linhas com NA (se necessário)
det_17_22 <- na.omit(det_17_22)
# modelo geral sem categoria de referência
binomial_model <- glm(dengue_pattern_17_22 ~ ., data = det_17_22 , family = binomial)
summary(binomial_model)
# 2. Verificação de Multicolinearidade (VIF)
# VIF só pode ser calculado em variáveis numéricas, então convertemos as categóricas para dummies
# Calcular os valores de VIF
vif_values <- vif(binomial_model)
# Converter VIF para um dataframe, extraindo a coluna correta
vif_df <- as.data.frame(vif_values)
colnames(vif_df) <- c("GVIF", "Df", "GVIF_ajustado")
# Exibir os valores de VIF ajustados
cat("\nValores de VIF ajustados:\n")
print(vif_df)
# Criar um dataframe com variáveis que possuem VIF ≥ 10
high_vif_vars <- rownames(vif_df[vif_df$GVIF_ajustado >= 10, ])
# Salvar as variáveis com alto VIF em um arquivo CSV
write.csv(data.frame(Variavel = high_vif_vars, VIF_Ajustado = vif_df$GVIF_ajustado[high_vif_vars]),
"vif_binomial_model_17_22.csv", row.names = FALSE)
# Remover variáveis com VIF ≥ 10 do banco de dados
det_17_22 <- det_17_22[, !(names(det_17_22) %in% high_vif_vars)]
# Exibir as colunas restantes no banco de dados atualizado
cat("\nColunas restantes após remoção de variáveis com alto VIF:\n")
print(names(det_17_22))
# 3. Verificação de Outliers com Resíduos Padronizados
# Criar uma coluna de resíduos padronizados
det_17_22$residuos <- rstandard(binomial_model)
# Filtrar apenas os outliers (resíduos <= -3 ou >= 3)
outliers <- det_17_22 %>% filter(residuos <= -3 | residuos >= 3)
# Verificar o novo banco de dados com os outliers
print(outliers)
# Salvando banco
write.csv(outliers, "outliers_binomial_model_17_22.csv", row.names = FALSE)
# Removendo as observações que eram outliers (≤ -3 ou ≥ 3).
det_17_22<- det_17_22 %>% filter(residuos > -3 & residuos < 3)
#Visualization
ggplot(det_17_22  , aes(x = 1:nrow(det_17_22), y = residuos)) +
geom_point() +
geom_hline(yintercept = c(-3, 3), linetype = "dashed", color = "red") +
labs(title = "Verificação de Outliers", x = "Índice", y = "Resíduos Padronizados")
# Remover colunas pelo nome
det_17_22 <- det_17_22[, !names(det_17_22) %in% c("muni_code")]
det_17_22$region <- as.factor(det_17_22$region)
# removendo as linhas com Na
det_17_22 <- det_17_22%>%
filter(!if_any(where(is.numeric), is.na))
# Definir a categoria de referência para todas as variáveis categóricas
det_17_22$dengue_pattern_17_22 <- relevel(det_17_22$dengue_pattern_17_22, ref = "0") # variável dependente
# Variáveis independentes
det_17_22$region <- relevel(det_17_22$region, ref = "3")
det_17_22$bioma <- relevel(det_17_22$bioma, ref = "Mata Atlantica")
det_17_22$tipo_regiao <- relevel(det_17_22$tipo_regiao , ref = "nao metropolitana")
det_17_22$dengue_pattern_10_16 <- relevel(det_17_22$dengue_pattern_10_16, ref = "0")
det_17_22$koppen <- relevel(det_17_22$koppen, ref = "Aw")
# excluindo os resídos
det_17_22$residuos<- NULL
# dando peso as categorias da variável dependente
weights_vector <- ifelse(det_17_22$dengue_pattern_17_22 == 1, 6, 1)
# Criar modelo logístico binomial
binomial_model <- glm(weights = weights_vector, dengue_pattern_17_22 ~ ., data = det_17_22, family = binomial)
summary(binomial_model)
# Criar o modelo inicial (nulo com region e pop22)
null_model <- glm(dengue_pattern_17_22 ~ region + pop22,
data = det_17_22,
family = binomial)
# Criar o modelo completo (com todas as variáveis preditoras adicionais)
full_formula <- as.formula(paste("dengue_pattern_17_22 ~ region + pop22 +",
paste(setdiff(names(det_17_22), c("dengue_pattern_17_22_17_22", "region", "pop22")),
collapse = " + ")))
full_model <- glm(full_formula, data = det_17_22, family = binomial)
# Aplicar a seleção stepwise sem mostrar o processo intermediário
step_model <- stepAIC(null_model,
scope = list(lower = null_model, upper = full_model),
direction = "both",
trace = FALSE)  # <- Isso esconde as iterações
# Exibir apenas o resumo final do modelo
print(summary(step_model))
# Criar o modelo inicial (nulo com region e pop22)
null_model <- glm(weights = weights_vector, dengue_pattern_17_22 ~ region +                   pop22, data = det_17_22,
family = binomial)
# Criar o modelo completo (com todas as variáveis preditoras adicionais)
full_formula <- as.formula(paste("dengue_pattern_17_22 ~ region + pop22 +",
paste(setdiff(names(det_17_22), c("dengue_pattern_17_22_17_22", "region", "pop22")),
collapse = " + ")))
full_model <- glm(full_formula, data = det_17_22, family = binomial)
# Aplicar a seleção stepwise sem mostrar o processo intermediário
step_model <- stepAIC(null_model,
scope = list(lower = null_model, upper = full_model),
direction = "both",
trace = FALSE)  # <- Isso esconde as iterações
# Exibir apenas o resumo final do modelo
print(summary(step_model))
# Pseudo R²
pR2(step_model)
# Teste de verossimilhança (Comparação com modelo nulo)
anova(null_model, step_model, test = "Chisq")
#Curva ROC e AUC (Área Sob a Curva)
roc_curve <- roc(det_17_22$dengue_pattern_17_22, fitted(step_model))
plot(roc_curve, col = "blue", main = "Curva ROC")
auc(roc_curve) # Calcula a AUC
# Matriz de Confusão e Acurácia
predicoes <- ifelse(fitted(step_model) > 0.5, 1, 0)
conf_matrix <- confusionMatrix(as.factor(predicoes), as.factor(det_17_22$dengue_pattern_17_22))
print(conf_matrix)
