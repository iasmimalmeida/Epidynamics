# Carregar os dados
d1 <- read.csv2("Dados/Determinantes/banco_determinantes_bi.csv", fileEncoding = "latin1")
d2 <- read.csv2("Dados/Determinantes/banco_determinantes_bi.csv", fileEncoding = "latin1")
# Identificar colunas com valores NA
print(names(d1)[colSums(is.na(d1)) > 0])
# Transformar variáveis selecionadas em fatores
factor_vars <- c("dengue_pattern_10_16", "dengue_pattern_17_22","tipo_regiao", "bioma", "koppen","region")
d1[factor_vars] <- lapply(d1[factor_vars], factor)
# Identificar colunas com valores NA
print(names(d2)[colSums(is.na(d2)) > 0])
# Transformar variáveis selecionadas em fatores
factor_vars <- c("dengue_pattern_10_16", "dengue_pattern_17_22","tipo_regiao", "bioma", "koppen","region")
d2[factor_vars] <- lapply(d1[factor_vars], factor)
# Função para criar tabela com valores absolutos e proporções
create_summary_table_d1 <- function(variable, dengue_pattern_10_16, margin){
table_values <- table(variable, dengue_pattern_10_16)
proportions <- prop.table(table_values, margin = margin)
# Combinando valores absolutos e proporções
summary_table <- paste(table_values, "(", round(proportions * 100, 1), "%)", sep = "")
summary_table <- matrix(summary_table, nrow = nrow(table_values), dimnames = dimnames(table_values))
# Reformatando para a tabela final com categorias de dengue_pattern nas colunas
summary_df <- as.data.frame(summary_table)
summary_df$Variable <- rownames(summary_df)
summary_df <- summary_df[, c("Variable", "0", "1")]
return(summary_df)
}
# Criando as tabelas para cada variável, ajustando o margin (1 para linha, 2 para coluna)
bioma_summary <- create_summary_table_d1(d1$bioma, d1$dengue_pattern_10_16, margin = 1)
koppen_summary <- create_summary_table_d1(d1$koppen, d1$dengue_pattern_10_16, margin = 1)
tipo_regiao_summary <- create_summary_table_d1(d1$tipo_regiao, d1$dengue_pattern_10_16, margin = 2)
region_summary <- create_summary_table_d1(d1$region, d1$dengue_pattern_10_16, margin = 1)
# Exibindo as tabelas
bioma_summary
koppen_summary
tipo_regiao_summary
region_summary
# Salvando os resultados
write.csv2(bioma_summary, "Dados/Determinantes/10-16/Binomial/bioma_summary_10_16.csv", row.names = FALSE)
write.csv2(koppen_summary, "Dados/Determinantes/10-16/Binomial/koppen_summary_10_16.csv", row.names = FALSE)
write.csv2(tipo_regiao_summary, "Dados/Determinantes/10-16/Binomial/tipo_regiao_summary_10_16.csv", row.names = FALSE)
write.csv2(region_summary, "Dados/Determinantes/10-16/Binomial/region_summary_10_16.csv", row.names = FALSE)
## Análise bivariada
# Função para realizar o teste qui-quadrado ou Fisher com ajustes para grandes tabelas
perform_bivariate_test <- function(variable, dengue_pattern_10_16) {
contingency_table <- table(variable, dengue_pattern_10_16)
# Verificar se todas as frequências esperadas são maiores que 5 (requisito para qui-quadrado)
chi_test <- chisq.test(contingency_table)
min_expected <- min(chi_test$expected)
if (min_expected > 5) {
test_result <- chi_test
test_type <- "Chi-squared"
} else {
# Usando Fisher com simulação para grandes tabelas
test_result <- fisher.test(contingency_table, simulate.p.value = TRUE, B = 10000)
test_type <- "Fisher (simulated)"
}
# Criar um dataframe com os resultados
result_df <- data.frame(
Variable = deparse(substitute(variable)),
Test = test_type,
p_value = test_result$p.value
)
return(result_df)
}
# Aplicando a função para cada variável categórica
bioma_test <- perform_bivariate_test(d1$bioma, d1$dengue_pattern_10_16)
koppen_test <- perform_bivariate_test(d1$koppen, d1$dengue_pattern_10_16)
tipo_regiao_test <- perform_bivariate_test(d1$tipo_regiao, d1$dengue_pattern_10_16)
region_test <- perform_bivariate_test(d1$region, d1$dengue_pattern_10_16)
# Juntando os resultados em um único dataframe
bivariate_results <- rbind(bioma_test, koppen_test, tipo_regiao_test, region_test)
# Exibindo os resultados
print(bivariate_results)
# Salvando os resultados em CSV
write.csv2(bivariate_results, "Dados/Determinantes/10-16/Binomial/bivariate_tests_10_16.csv", row.names = FALSE)
# Função para criar tabela com valores absolutos e proporções para 2017-2022
create_summary_table_d2 <- function(variable, dengue_pattern_17_22, margin){
table_values <- table(variable, dengue_pattern_17_22)
proportions <- prop.table(table_values, margin = margin)
# Combinando valores absolutos e proporções
summary_table <- paste(table_values, "(", round(proportions * 100, 1), "%)", sep = "")
summary_table <- matrix(summary_table, nrow = nrow(table_values), dimnames = dimnames(table_values))
# Reformatando para a tabela final com categorias de dengue_pattern nas colunas
summary_df <- as.data.frame(summary_table)
summary_df$Variable <- rownames(summary_df)
summary_df <- summary_df[, c("Variable", "0", "1")]
return(summary_df)
}
# Criando as tabelas para cada variável, ajustando o margin (1 para linha, 2 para coluna)
bioma_summary_17_22 <- create_summary_table_d2(d2$bioma, d2$dengue_pattern_17_22, margin = 1)
koppen_summary_17_22 <- create_summary_table_d2(d2$koppen, d2$dengue_pattern_17_22, margin = 1)
tipo_regiao_summary_17_22 <- create_summary_table_d2(d2$tipo_regiao, d2$dengue_pattern_17_22, margin = 2)
region_summary_17_22 <- create_summary_table_d2(d2$region, d2$dengue_pattern_17_22, margin = 1)
# Salvando os arquivos em uma nova pasta para evitar conflitos
write.csv2(bioma_summary_17_22, "Dados/Determinantes/17-22/Binomial/bioma_summary_17_22.csv", row.names = FALSE)
write.csv2(koppen_summary_17_22, "Dados/Determinantes/17-22/Binomial/koppen_summary_17_22.csv", row.names = FALSE)
write.csv2(tipo_regiao_summary_17_22, "Dados/Determinantes/17-22/Binomial/tipo_regiao_summary_17_22.csv", row.names = FALSE)
write.csv2(region_summary_17_22, "Dados/Determinantes/17-22/Binomial/region_summary_17_22.csv", row.names = FALSE)
## Análise Bivariada
# Função para realizar o teste qui-quadrado ou Fisher com ajustes para grandes tabelas
perform_bivariate_test <- function(variable, dengue_pattern_17_22) {
contingency_table <- table(variable, dengue_pattern_17_22)
# Verificar a menor frequência esperada na tabela
chi_test <- chisq.test(contingency_table)
min_expected <- min(chi_test$expected)
if (min_expected > 5) {
test_result <- chi_test
test_type <- "Chi-squared"
} else {
# Usando Fisher com simulação para grandes tabelas
test_result <- fisher.test(contingency_table, simulate.p.value = TRUE, B = 10000)
test_type <- "Fisher (simulated)"
}
# Criar um dataframe com os resultados
result_df <- data.frame(
Variable = deparse(substitute(variable)),
Test = test_type,
p_value = test_result$p.value
)
return(result_df)
}
# Aplicando a função para cada variável categórica no período 2017-2022
bioma_test <- perform_bivariate_test(d1$bioma, d1$dengue_pattern_17_22)
koppen_test <- perform_bivariate_test(d1$koppen, d1$dengue_pattern_17_22)
tipo_regiao_test <- perform_bivariate_test(d1$tipo_regiao, d1$dengue_pattern_17_22)
region_test_17_22 <- perform_bivariate_test(d2$region, d2$dengue_pattern_17_22)
# Juntando os resultados em um único dataframe
bivariate_results_17_22 <- rbind(bioma_test, koppen_test, tipo_regiao_test,region_test_17_22)
# Exibindo os resultados
print(bivariate_results_17_22)
# Salvando os resultados em CSV
write.csv2(bivariate_results_17_22, "Dados/Determinantes/17-22/Binomial/bivariate_tests_17_22.csv", row.names = FALSE)
# Função para calcular frequências e formatar os resultados
calculate_frequencies <- function(df, column, muni_code_column = 'muni_code') {
df %>%
group_by(!!sym(column)) %>%
summarise(Absolute_Frequency = n()) %>%
mutate(Relative_Frequency = (Absolute_Frequency / sum(Absolute_Frequency)) * 100) %>%
mutate(Result = paste0(Absolute_Frequency, " (", round(Relative_Frequency, 2), "%)"))
}
# Calcular as frequências para cada variável
bioma_freq <- calculate_frequencies(d1, 'bioma')
koppen_freq <- calculate_frequencies(d1, 'koppen')
tipo_regiao_freq <- calculate_frequencies(d1, 'tipo_regiao')
region_freq <- calculate_frequencies(d1, 'region')
# Exibir os resultados
print(bioma_freq)
write.csv2(bioma_freq, "Dados/Determinantes/Brasil Geral/bio.csv")
print(koppen_freq)
write.csv2(koppen_freq, "Dados/Determinantes/Brasil Geral/kop.csv")
print(tipo_regiao_freq)
write.csv2(tipo_regiao_freq, "Dados/Determinantes/Brasil Geral/tipo.csv")
print(region_freq)
write.csv2(region_freq, "Dados/Determinantes/Brasil Geral/region.csv")
